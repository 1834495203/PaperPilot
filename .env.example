DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DATABASE_URL=sqlite+aiosqlite:///./paperpilot.db
FRONTEND_ORIGIN=http://localhost:3000
SUPERVISOR_MAX_STEPS=8
SEARCH_MAX_ITERATIONS=2
OPENALEX_API_URL=https://api.openalex.org
# Optional for casual use; recommended for a larger paper library.
OPENALEX_API_KEY=
OPENALEX_TIMEOUT_SECONDS=15
OPENALEX_MIN_REQUEST_INTERVAL_SECONDS=0.1
OPENALEX_MAX_RETRIES=1
OPENALEX_RETRY_BACKOFF_SECONDS=1
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1
# Optional, but avoids the shared unauthenticated rate limit.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=15
SEMANTIC_SCHOLAR_MIN_REQUEST_INTERVAL_SECONDS=1
SEMANTIC_SCHOLAR_MAX_RETRIES=1
SEMANTIC_SCHOLAR_RETRY_BACKOFF_SECONDS=1
ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3
ARXIV_MAX_RETRIES=1
ARXIV_RETRY_BACKOFF_SECONDS=3
PDF_TIMEOUT_SECONDS=30
PDF_MAX_BYTES=20000000
PDF_MAX_PAGES=80
READER_MAX_INPUT_CHARS=100000
READER_MAX_RETRIEVAL_ROUNDS=2
# 最终回答的引用核验：逐条检查引用证据是否支持其所在结论
ENABLE_CITATION_VERIFICATION=true
CITATION_VERIFICATION_MAX_CITATIONS=12
# 运行事件的内存回放缓冲：断线重连可以从此前的事件序号继续
RUN_REPLAY_BUFFER_SIZE=2000
# AI 任务规划节点：在任何检索之前产出显式任务计划（任务类型、检索策略、答案维度、停止条件）
ENABLE_RESEARCH_PLANNER=true
PLANNER_MAX_ANSWER_DIMENSIONS=4
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=qwen3-embedding:latest
# 留空时使用模型原始维度；本地 qwen3-embedding:latest 当前为 4096 维
# EMBEDDING_DIMENSIONS=4096
VECTOR_DB_PATH=./data/chroma
VECTOR_COLLECTION=paperpilot_tree_chunks
# 索引指纹不匹配时拒绝读写，避免把不同 embedding 模型写进同一个向量空间
VECTOR_ENFORCE_INDEX_SIGNATURE=true
PAPER_LIBRARY_PATH=./data/papers
UPLOAD_MAX_BYTES=30000000
TREE_CHUNK_MAX_CHARS=1800
# 相邻文本 chunk 之间按句子重合的句数（保证句子完整性 + 上下文连续）
TREE_CHUNK_OVERLAP_SENTENCES=1
RETRIEVAL_INITIAL_TOP_K=12
RETRIEVAL_FINAL_TOP_K=8
RETRIEVAL_MAX_EXPANDED_PER_HIT=8
RETRIEVAL_MAX_CANDIDATES=40
RETRIEVAL_MAX_CHUNKS_PER_PAPER=3
RETRIEVAL_PAPER_TOP_K=5
RETRIEVAL_SECTIONS_PER_PAPER=3
RETRIEVAL_GLOBAL_FALLBACK_TOP_K=6
# 独立的全文关键词召回通道（与向量召回并行，用 RRF 融合排名）
RETRIEVAL_KEYWORD_ENABLED=true
RETRIEVAL_KEYWORD_TOP_K=10
# 每个关键词最多取多少条记录参与 BM25；触顶的词会出现在 keyword_truncated_terms
RETRIEVAL_KEYWORD_FILTER_LIMIT=400
# 精排候选池：先保留较宽候选，再去重、多样性、精排，最后按覆盖与预算裁剪
RETRIEVAL_RERANK_CANDIDATE_LIMIT=30
# multi_paper 策略：每篇论文的片段上限（实际取 max(该值, 比较维度数)）
RETRIEVAL_MULTI_PAPER_CHUNKS_PER_PAPER=2
# corpus_survey 策略：候选论文数、最终证据数与总上限
RETRIEVAL_SURVEY_PAPER_TOP_K=20
RETRIEVAL_SURVEY_FINAL_TOP_K=16
RETRIEVAL_MAX_FINAL_TOP_K=24
# 树扩展按层按需读取子节点，最多下探多少层
RETRIEVAL_MAX_EXPANSION_LEVELS=2
# RRF 融合常数（标准取值 60）
RETRIEVAL_RRF_CONSTANT=60
# 融合分数在初排中的加权增益；0 表示只合并候选、不参与排序
RETRIEVAL_RRF_RANKING_WEIGHT=0.20
RETRIEVAL_MIN_RANKING_SCORE=0.20
RETRIEVAL_SCORE_WINDOW=0.18
RETRIEVAL_MMR_TOP_K=30
RETRIEVAL_MMR_LAMBDA=0.70
# Optional true Cross-Encoder. Install with: pip install -e ".[reranker]"
# Recommended multilingual model: cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_MODEL=
RERANKER_DEVICE=
RERANKER_MAX_LENGTH=512
